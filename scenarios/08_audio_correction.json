{
  "name": "08_audio_correction",
  "description": "Spoken request as a WAV clip, then a spoken correction of the date while the search is in flight.",
  "modality": "audio",
  "tools": {
    "flight_search": {
      "latency": 3.0
    }
  },
  "events": [
    {
      "t": 0.5,
      "type": "audio_clip",
      "path": "assets/find_flights_tokyo.wav"
    },
    {
      "t": 1.5,
      "type": "interrupt"
    },
    {
      "t": 1.5,
      "type": "audio_clip",
      "path": "assets/make_it_thursday.wav"
    }
  ],
  "expected": {
    "final_snapshot": {
      "intent": "flight_search",
      "slots": {
        "origin": "London",
        "destination": "Tokyo",
        "date": "Thursday"
      }
    },
    "cancelled": [
      {
        "name": "flight_search",
        "args": {
          "date": "Wednesday"
        }
      }
    ],
    "calls": [
      {
        "name": "flight_search",
        "args": {
          "date": "Thursday"
        },
        "min": 1,
        "max": 1,
        "succeeded": true
      }
    ]
  }
}
