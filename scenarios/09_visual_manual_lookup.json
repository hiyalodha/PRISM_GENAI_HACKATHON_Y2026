{
  "name": "09_visual_manual_lookup",
  "description": "Camera frame of a router plus a deictic question; the agent grounds the device model in the frame and looks up the manual.",
  "modality": "visual",
  "tools": {
    "manual_lookup": {
      "latency": 1.0
    }
  },
  "events": [
    {
      "t": 0.3,
      "type": "frame",
      "path": "assets/router_x200.png"
    },
    {
      "t": 0.5,
      "type": "text_chunk",
      "text": "What does this blinking red light mean?",
      "end_of_turn": true
    }
  ],
  "expected": {
    "final_snapshot": {
      "intent": "manual_lookup",
      "slots": {
        "device_model": "X200"
      }
    },
    "calls": [
      {
        "name": "manual_lookup",
        "args": {
          "device_model": "X200"
        },
        "min": 1,
        "max": 1,
        "succeeded": true
      }
    ],
    "final_text_contains": [
      "no internet"
    ],
    "clarify": false
  }
